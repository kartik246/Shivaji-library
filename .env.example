# Root Environment Template
# -----------------------------------------------
# SERVER (.env placed in /server/.env)
# -----------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/shivaji_library?retryWrites=true&w=majority
JWT_SECRET=shivaji_library_super_secret_jwt_key_2026_secure
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional Online Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Email / SMTP configuration (Nodemailer logs previews to console if omitted)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Shivaji Library <noreply@shivajilibrary.com>"

# -----------------------------------------------
# CLIENT (.env placed in /client/.env)
# -----------------------------------------------
VITE_API_BASE_URL=